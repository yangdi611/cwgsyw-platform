FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci \
  && sha256sum package-lock.json > node_modules/.package-lock.sha256
COPY docker-entrypoint.dev.sh /usr/local/bin/frontend-dev-entrypoint
RUN chmod +x /usr/local/bin/frontend-dev-entrypoint

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["frontend-dev-entrypoint"]
